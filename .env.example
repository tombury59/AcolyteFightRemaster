# URL du serveur relais multijoueur (WebSocket).
# - Non défini  => mode solo (boucle locale dans le navigateur, aucun serveur requis).
# - Défini      => mode en ligne : les amis se rejoignent via ce relais.
#
# Dev local (relais lancé via `npm run server`) :
# VITE_SERVER_URL=ws://localhost:7770
#
# Prod (relais déployé, ex. Fly.io/Render) — toujours en WSS derrière HTTPS :
# VITE_SERVER_URL=wss://mon-relais.example.com
VITE_SERVER_URL=
